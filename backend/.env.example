# Server
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
ENABLE_DEBUG_ENDPOINTS=true
DEBUG_TOKEN=

# Upstash Redis (required for caching)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anakin (Phase 2 will use this)
ANAKIN_API_KEY=
ANAKIN_API_BASE_URL=https://api.anakin.io/v1

# Groq (Phase 2 will use this)
GROQ_API_KEY=

# Optional CORS allowlist (comma separated).
# Supports exact origins and wildcard patterns like "http://localhost:*" or "chrome-extension://*".
# If empty, all origins are allowed.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,chrome-extension://*

